<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Let the app's own JSON error replies (422, 429, 502, ...) through. Without this,
         IIS swaps them for "The custom error module does not recognize this error." -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
